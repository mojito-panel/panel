# ─── Common ────────────────────────────────────────────────────────────────────
NODE_ENV=development

# ─── Panel ────────────────────────────────────────────────────────────────────
# Database (Postgres — docker compose dev, shared better-auth + MikroORM)
DATABASE_URL=postgres://mojito:mojito@localhost:5432/mojito

# Panel URL — must match the dev server port (vite.config.ts)
BETTER_AUTH_URL=http://localhost:5173
PANEL_URL=http://localhost:5173

# better-auth secret (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# ALSO used to encrypt the agent tokens at rest (AES-256-GCM key derivation). NEVER log it.
BETTER_AUTH_SECRET=change-me-generate-a-32-bytes-secret

# Panel server port
PORT=5173

# ─── Panel settings (MOJITO_* overrides) ─────────────────────────────────────
# Panel settings live in the DB (`setting` table, admin > Paramètres) with
# code defaults (src/lib/settings.ts). Any key can be FORCED by an env var —
# it then overrides the DB value and the admin UI locks the field.
# Name: MOJITO_ + key with ":" → "_" uppercased. Examples:
#   MOJITO_APP_NAME=Mojito Panel
#   MOJITO_APP_FAVICON=https://example.com/favicon.ico
#   MOJITO_APP_GRAVATAR=false
#   MOJITO_APP_REGISTRATION_ENABLED=true
#   MOJITO_MAIL_SMTP_HOST=smtp.example.com
#   MOJITO_MAIL_SMTP_PORT=587
#   MOJITO_MAIL_SMTP_USERNAME=
#   MOJITO_MAIL_SMTP_PASSWORD=
#   MOJITO_MAIL_SMTP_ENCRYPTION=tls|starttls|none
#   MOJITO_MAIL_FROM_ADDRESS=panel@example.com
#   MOJITO_MAIL_FROM_NAME=Mojito Panel
# An empty value is ignored (unset semantics).
