# ─── Agent ────────────────────────────────────────────────────────────────────
# Token Bearer (générer avec: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
AGENT_TOKEN=change-me-generate-a-32-bytes-token

# Port et interface d'écoute
AGENT_PORT=8080
AGENT_HOST=0.0.0.0

# Dossier de données des serveurs
AGENT_DATA_DIR=C:\PanelData

# URL du panel (pour connexion WS sortante, phase 3)
PANEL_URL=http://localhost:3000

# Version de l'agent
AGENT_VERSION=0.1.0
