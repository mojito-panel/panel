# ─── Agent ────────────────────────────────────────────────────────────────────
# Bearer token (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# Also used as the HS256 key to verify console JWTs (Pelican-style single secret,
# identical to the token stored on the node in the panel). NEVER log it.
AGENT_TOKEN=change-me-generate-a-32-bytes-token

# Listen port and interface
AGENT_PORT=8080
AGENT_HOST=0.0.0.0

# Server data directory
AGENT_DATA_DIR=C:\PanelData

# Panel URL — origin allowed to open the browser console WS (must match the
# panel's own URL, e.g. http://localhost:5173 in dev)
PANEL_URL=http://localhost:5173

# Extra origins allowed to open the console WS (comma-separated, optional)
AGENT_ALLOWED_ORIGINS=

# Agent version
AGENT_VERSION=0.1.0
