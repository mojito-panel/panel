# ─── Panel ────────────────────────────────────────────────────────────────────
# Database (Postgres — docker compose dev, shared better-auth + MikroORM)
DATABASE_URL=postgres://mojito:mojito@localhost:5432/mojito

# Panel URL — must match the dev server port (vite.config.ts)
BETTER_AUTH_URL=http://localhost:5173
PANEL_URL=http://localhost:5173

# better-auth secret (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
BETTER_AUTH_SECRET=change-me-generate-a-32-bytes-secret

# Panel server port
PORT=5173
