# ─── Panel ────────────────────────────────────────────────────────────────────
# Base de données (Postgres — docker compose dev, partagée better-auth + MikroORM)
DATABASE_URL=postgres://mojito:mojito@localhost:5432/mojito

# URL du panel — doit correspondre au port du dev server (vite.config.ts)
BETTER_AUTH_URL=http://localhost:5173
PANEL_URL=http://localhost:5173

# Secret better-auth (générer avec: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
BETTER_AUTH_SECRET=change-me-generate-a-32-bytes-secret

# Port du serveur panel
PORT=5173
