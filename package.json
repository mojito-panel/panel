{
  "name": "mojito-panel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Panel d'hébergement de serveurs de jeux, natif Windows, sans Docker",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src tests",
    "lint:fix": "oxlint src tests --fix",
    "fmt": "oxfmt src tests",
    "fmt:check": "oxfmt --check src tests",
    "db:migrate": "mikro-orm migration:create",
    "db:migrate:up": "mikro-orm migration:up"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@mikro-orm/core": "^7.2.5",
    "@mikro-orm/migrations": "^7.2.5",
    "@mikro-orm/postgresql": "^7.2.5",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.132.0",
    "@tanstack/react-start": "^1.132.0",
    "@tanstack/react-table": "^9.3.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/xterm": "^6.0.0",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "croner": "^11.0.0",
    "lucide-react": "^0.545.0",
    "monaco-editor": "^0.57.0",
    "next-themes": "^0.4.6",
    "nitro": "^3.0.260903-beta",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@mikro-orm/cli": "^7.2.5",
    "@mikro-orm/sqlite": "^7.2.5",
    "@oxc-node/core": "^1.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.7.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.2",
    "vite": "^8.3.4",
    "vitest": "^3.2.4"
  }
